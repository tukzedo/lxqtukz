##	Test box: the build box plus what it takes to run our apps on a headless
##	Wayfire. Kept apart so the release build never sees a system Wayfire or
##	the QML runtime modules.

ARG BASE=lxqtukz-build-debian13
FROM ${BASE}

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
	wayfire grim libgl1-mesa-dri libegl-mesa0 mesa-vulkan-drivers fonts-dejavu-core \
	qt6-wayland qml6-module-qtquick qml6-module-qtquick-controls qml6-module-qtquick-layouts \
	qml6-module-qtquick-window qml6-module-qtquick-templates qml6-module-qtqml-workerscript \
	qml6-module-qtquick-dialogs qml6-module-org-kde-desktop lxqt-qtplugin \
	qterminal xwayland xclip wl-clipboard x11-apps \
	swaybg psmisc xdg-desktop-portal gtklock gtklock-userinfo-module librsvg2-common swayidle \
	&& rm -rf /var/lib/apt/lists/*

## Debian's is older than the pin in cicd/config.bash; bump both together.
ARG SHELLCHECK_VER=0.11.0
ARG SHELLCHECK_SHA256=8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198
RUN curl -fsSLo /tmp/sc.txz "https://github.com/koalaman/shellcheck/releases/download/v${SHELLCHECK_VER}/shellcheck-v${SHELLCHECK_VER}.linux.x86_64.tar.xz" \
	&& echo "${SHELLCHECK_SHA256}  /tmp/sc.txz" | sha256sum -c - \
	&& tar -C /usr/local/bin --strip-components=1 -xJf /tmp/sc.txz "shellcheck-v${SHELLCHECK_VER}/shellcheck" \
	&& rm -f /tmp/sc.txz
